# Review provider.
# Local / tests default: fixture (no API key required).
# Production path: deepseek (low-cost domestic model).
# openai is benchmark-only and must not be used as the default production provider.
REVIEW_PROVIDER=fixture

# Required only when REVIEW_PROVIDER=deepseek.
# Presence of this key must not start npm test, dev-live, or locked evaluation.
# The product UI can also accept this key into server-side session memory.
# Session keys are not written to disk and are discarded on process restart.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Server-side model name. Production default is deepseek-v4-flash.
REVIEW_MODEL=deepseek-v4-flash

# Benchmark-only. Application startup must not depend on this key.
# Presence of this key must not start npm test or live inference entries.
OPENAI_API_KEY=

# SQLite path. Runtime DB must not be committed.
REVIEW_DB_PATH=.data/guangming-review.db

# Server-side only. Live Web Evidence from .env.local requires BOTH
# WEB_EVIDENCE_ENABLED=true and TAVILY_API_KEY. A Tavily key submitted in the
# product UI enables web evidence for that server session without this flag.
# Never use NEXT_PUBLIC_. Do not commit keys.
WEB_EVIDENCE_ENABLED=
TAVILY_API_KEY=

# Server-side only. Multi-agent specialists stay off unless REVIEW_SPECIALISTS_ENABLED=1.
# Live calls reuse the existing DeepSeek provider (DEEPSEEK_API_KEY) as DeepSeek-V4-flash
# fact_check / news_edit specialists. Never use NEXT_PUBLIC_. Do not commit keys.
REVIEW_SPECIALISTS_ENABLED=
