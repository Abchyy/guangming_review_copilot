# Review provider.
# Local / tests default: fixture (no API key required).
# Production path: deepseek (low-cost domestic model).
# openai is benchmark-only and must not be used as the default production provider.
REVIEW_PROVIDER=fixture

# Required only when REVIEW_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Server-side model name. Production default is deepseek-v4-flash.
REVIEW_MODEL=deepseek-v4-flash

# Benchmark-only. Application startup must not depend on this key.
OPENAI_API_KEY=

# SQLite path. Runtime DB must not be committed.
REVIEW_DB_PATH=.data/guangming-review.db
