# Review provider: "fixture" (deterministic, default) or "openai"
REVIEW_PROVIDER=fixture

# Required only when REVIEW_PROVIDER=openai
OPENAI_API_KEY=

# Server-side model name. Do not hardcode in application code.
REVIEW_MODEL=gpt-5.6-terra

# SQLite path. Runtime DB must not be committed.
REVIEW_DB_PATH=.data/guangming-review.db
